# انسخ هذا الملف باسم .env واملأ القيم من مشروع Supabase بتاعك
# (Settings → API في لوحة تحكم Supabase)
#
# Copy this file to .env and fill in the values from your Supabase project
# (Settings → API in the Supabase dashboard)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# اختياري — بس بعد ما توافق عليكي Google AdSense (شوفي README قسم الإعلانات)
# Optional — only after Google AdSense approves your site (see README ads section)
VITE_ADSENSE_CLIENT_ID=
